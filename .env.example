# Conexão Postgres do Supabase — use a URL do "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Storage (fotos e relatórios) — chave service_role, somente no servidor
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sgq-arquivos
# Responsável pelo SGQ (libera acessos e cria contratos)
OWNER_EMAIL=smaiavitorvinicius@gmail.com
# true = tela de campo sem login (como o sistema original). Padrão: exige login.
SGQ_CAMPO_PUBLICO=false
